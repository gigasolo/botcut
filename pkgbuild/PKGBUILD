# Maintainer: Lon Baker (fork of omacut by David Heinemeier Hansson)

pkgname=botcut
pkgver=0.1.0
pkgrel=1
pkgdesc='AI-assisted rough-cut reviewer, a fork of omacut (Qt Quick + ffmpeg)'
arch=('x86_64')
url='https://github.com/gigasolo/botcut'
license=('MIT')
install='botcut.install'
depends=('ffmpeg' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-multimedia')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/botcut "$pkgdir/usr/bin/botcut"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/botcut.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/botcut.svg"
  /usr/bin/install -Dm644 "$startdir/botcut.desktop" "$pkgdir/usr/share/applications/botcut.desktop"
}
